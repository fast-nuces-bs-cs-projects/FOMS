{
  "info": {
    "name": "Foodie API",
    "description": "API Collection for the Foodie App (Android & JavaFX)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Admin Login (JavaFX)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set(\"token\", jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@foodie.com\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Customer Login (Android)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set(\"token\", jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Customer Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set(\"token\", jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Jane Smith\",\n  \"email\": \"jane@example.com\",\n  \"password\": \"securepassword\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "register"]
            }
          }
        }
      ]
    },
    {
      "name": "2. User Profile",
      "item": [
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/user/profile",
              "host": ["{{base_url}}"],
              "path": ["api", "user", "profile"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Menu / Foods",
      "item": [
        {
          "name": "Get All Menu Items (JavaFX)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/menu",
              "host": ["{{base_url}}"],
              "path": ["api", "menu"]
            }
          }
        },
        {
          "name": "Get All Foods (Android)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/foods",
              "host": ["{{base_url}}"],
              "path": ["api", "foods"]
            }
          }
        },
        {
          "name": "Add Menu Item",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Spicy Chicken Burger\",\n  \"description\": \"Spicy and crispy chicken patty\",\n  \"category\": \"Main Course\",\n  \"price\": 950.00,\n  \"status\": \"Available\",\n  \"imageUrl\": \"/images/spicy_burger.png\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/menu",
              "host": ["{{base_url}}"],
              "path": ["api", "menu"]
            }
          }
        },
        {
          "name": "Update Menu Item",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Classic Burger Deluxe\",\n  \"description\": \"Juicy beef patty with extra cheese\",\n  \"category\": \"Main Course\",\n  \"price\": 900.00,\n  \"status\": \"Available\",\n  \"imageUrl\": \"/images/burger.png\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/menu/1",
              "host": ["{{base_url}}"],
              "path": ["api", "menu", "1"]
            }
          }
        },
        {
          "name": "Delete Menu Item",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{base_url}}/api/menu/1",
              "host": ["{{base_url}}"],
              "path": ["api", "menu", "1"]
            }
          }
        }
      ]
    },
