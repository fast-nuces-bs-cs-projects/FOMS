<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:layout_marginHorizontal="16dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:cardUseCompatPadding="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:background="@android:color/white">

        <ImageView
            android:id="@+id/cart_food_image"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:scaleType="centerCrop"
            android:background="#EEEEEE"
            android:src="@android:drawable/ic_menu_gallery" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/cart_food_image"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/cart_food_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Food Item"
                android:textColor="#000000"
                android:textSize="16sp"
                android:textStyle="bold" />
                
            <ImageView
                android:id="@+id/btn_delete"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_alignParentEnd="true"
                android:src="@drawable/ic_delete" />

            <TextView
                android:id="@+id/cart_food_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/cart_food_title"
                android:layout_marginTop="4dp"
                android:text="Description here"
                android:textColor="#888888"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/cart_food_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/cart_food_desc"
                android:layout_marginTop="16dp"
                android:text="Rs. 000"
                android:textColor="#2e933a"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignBottom="@id/cart_food_price"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                
                <TextView
                    android:id="@+id/btn_minus"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:text="-"
                    android:textColor="#2e933a"
                    android:gravity="center"
                    android:background="@drawable/bg_quantity_btn"
                    android:textStyle="bold"/>
                    
                <TextView
                    android:id="@+id/tv_quantity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1"
                    android:textColor="#000000"
                    android:textStyle="bold"
                    android:layout_marginHorizontal="12dp"/>
                    
                <TextView
                    android:id="@+id/btn_plus"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:text="+"
                    android:textColor="#2e933a"
                    android:gravity="center"
                    android:background="@drawable/bg_quantity_btn"
                    android:textStyle="bold"/>
            </LinearLayout>
        </RelativeLayout>
    </RelativeLayout>
</androidx.cardview.widget.CardView>
